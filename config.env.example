# SRKI dataset paths (Windows)
SRKI_DATASET_A=E:\Final_SRKI_dataset\Dataset_A_SRKI.json
SRKI_DATASET_B=E:\Final_SRKI_dataset\Dataset_B_SRKI.json

# Optional: curriculum JSON from earlier RAG project
SRKI_JSON_DATA_DIR=C:\Users\Shruti Revdiwala\COLLEGE_CHATBOT_RAG\data\json-data

# Active college (SU disabled until Phase 2)
ACTIVE_COLLEGE=SRKI

# Model paths (created by scripts)
INTENT_MODEL_DIR=models/srki_intent
RAG_INDEX_DIR=data/index/srki

# Inference
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INTENT_BASE_MODEL=distilbert-base-uncased
MAX_SEQ_LENGTH=128

# Web scraping (official SRKI pages — cached 24h by default)
WEB_SCRAPE_ENABLED=true
WEB_SEED_URLS=https://www.srki.ac.in/,https://www.srki.ac.in/pages/admission-corner/,https://www.srki.ac.in/contact/
WEB_CACHE_TTL_HOURS=24
WEB_MAX_PAGES=25
WEB_LIVE_ON_QUERY=false

# Multi-intent + unseen-intent handling
MULTI_INTENT_ENABLED=true
MULTI_INTENT_MAX=3
INTENT_CONFIDENCE_THRESHOLD=0.40

# External web search (non-SRKI institutions like VNSGU; DuckDuckGo, no API key)
EXTERNAL_SEARCH_ENABLED=true
EXTERNAL_SEARCH_MAX_RESULTS=5
EXTERNAL_SEARCH_FETCH_PAGES=1
EXTERNAL_SEARCH_TIMEOUT=9
EXTERNAL_SEARCH_CACHE_TTL_HOURS=12
EXTERNAL_INSTITUTIONS=vnsgu,veer narmad,veer narmad south gujarat university,south gujarat university,gtu,gujarat technological university,gujarat university,svnit,nit surat,auro university,uka tarsadia,bhagwan mahavir university

# Optional grounded generative model (anti-hallucination FLAN-T5)
USE_GENERATOR=false
GENERATOR_MODEL=google/flan-t5-base

# ===== General Education AI brain (Groq) =====
# assistant_mode: auto = use the LLM brain whenever GROQ_API_KEY is set,
#                 education = always use the LLM brain, srki = local SRKI pipeline.
ASSISTANT_MODE=auto
# Get a FREE key at https://console.groq.com (API Keys -> Create). Starts with gsk_
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
EDU_HISTORY_TURNS=6
EDU_SEARCH_MAX_QUERIES=3
